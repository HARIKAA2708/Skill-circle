<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>SkillCircle - Worker Details</title>

<style>

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #f4f7fb;
    color: #222;
    padding-bottom: 40px;
}

header {
    background: #5b3cc4;
    color: white;
    text-align: center;
    padding: 22px;
}

header h1 {
    margin-bottom: 7px;
}

.container {
    width: 94%;
    max-width: 700px;
    margin: 25px auto;
}

.card {
    background: white;
    padding: 24px;
    border-radius: 16px;
    margin-bottom: 20px;
    box-shadow: 0 4px 18px rgba(0,0,0,.08);
}

.card h2 {
    color: #5b3cc4;
    margin-bottom: 18px;
}

label {
    display: block;
    font-weight: bold;
    margin-top: 15px;
    margin-bottom: 7px;
}

input,
select,
textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #d5d5d5;
    border-radius: 9px;
    font-size: 15px;
}

textarea {
    min-height: 100px;
    resize: vertical;
}

.skills {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 10px;
}

.skill {
    border: 1px solid #ddd;
    border-radius: 9px;
    padding: 12px;
    background: #fafafa;
}

.skill label {
    margin: 0;
    font-weight: normal;
}

button {
    width: 100%;
    padding: 16px;
    margin-top: 20px;
    border: none;
    border-radius: 10px;
    background: #5b3cc4;
    color: white;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #472ca3;
}

.note {
    background: #f0ecff;
    padding: 14px;
    border-radius: 10px;
    margin-top: 15px;
    line-height: 1.5;
}

.back {
    display: block;
    text-align: center;
    color: #5b3cc4;
    text-decoration: none;
    font-weight: bold;
    margin-top: 18px;
}

@media(max-width:500px) {

    .skills {
        grid-template-columns: 1fr;
    }

}

</style>

</head>


<body>

<header>

    <h1>💼 SkillCircle</h1>

    <p>
        Worker Details
    </p>

</header>


<div class="container">

<form id="workerForm">


    <!-- BASIC DETAILS -->

    <div class="card">

        <h2>👤 Basic Details</h2>

        <label>
            Full Name
        </label>

        <input
            type="text"
            id="name"
            placeholder="Enter your full name"
            required
        >


        <label>
            Phone Number
        </label>

        <input
            type="tel"
            id="phone"
            placeholder="Enter phone number"
            required
        >


        <label>
            Work Area / Location
        </label>

        <input
            type="text"
            id="area"
            placeholder="Example: Kukatpally"
            required
        >

    </div>


    <!-- SKILLS -->

    <div class="card">

        <h2>🛠️ Skills You Can Perform</h2>

        <p>
            Select all types of work you can do.
        </p>


        <div class="skills">

            <div class="skill">
                <label>
                    <input
                        type="checkbox"
                        value="House Cleaning"
                    >
                    House Cleaning
                </label>
            </div>


            <div class="skill">
                <label>
                    <input
                        type="checkbox"
                        value="Cooking"
                    >
                    Cooking
                </label>
            </div>


            <div class="skill">
                <label>
                    <input
                        type="checkbox"
                        value="Gardening"
                    >
                    Gardening
                </label>
            </div>


            <div class="skill">
                <label>
                    <input
                        type="checkbox"
                        value="Painting"
                    >
                    Painting
                </label>
            </div>


            <div class="skill">
                <label>
                    <input
                        type="checkbox"
                        value="Babysitting"
                    >
                    Babysitting
                </label>
            </div>


            <div class="skill">
                <label>
                    <input
                        type="checkbox"
                        value="Tailoring"
                    >
                    Tailoring
                </label>
            </div>


            <div class="skill">
                <label>
                    <input
                        type="checkbox"
                        value="Electrical Work"
                    >
                    Electrical Work
                </label>
            </div>


            <div class="skill">
                <label>
                    <input
                        type="checkbox"
                        value="Video Editing"
                    >
                    Video Editing
                </label>
            </div>


            <div class="skill">
                <label>
                    <input
                        type="checkbox"
                        value="Graphic Design"
                    >
                    Graphic Design
                </label>
            </div>


            <div class="skill">
                <label>
                    <input
                        type="checkbox"
                        value="Student Helper"
                    >
                    Student Helper
                </label>
            </div>

        </div>

    </div>


    <!-- EXPERIENCE -->

    <div class="card">

        <h2>📋 Previous Experience</h2>


        <label>
            Previous Experience
        </label>

        <textarea
            id="experience"
            placeholder="Example: Worked as a house cleaner for 3 years"
            required
        ></textarea>


        <label>
            Experience Duration
        </label>

        <input
            type="text"
            id="experienceDuration"
            placeholder="Example: 3 years"
            required
        >

    </div>


    <!-- AVAILABILITY -->

    <div class="card">

        <h2>🕒 Availability</h2>


        <label>
            Preferred Time
        </label>

        <select id="availability" required>

            <option value="">
                Select time
            </option>

            <option>
                9:00 AM - 12:00 PM
            </option>

            <option>
                12:00 PM - 4:00 PM
            </option>

            <option>
                4:00 PM - 9:00 PM
            </option>

            <option>
                Flexible
            </option>

        </select>


        <label>
            Work Preference
        </label>

        <select id="workPreference" required>

            <option value="">
                Select preference
            </option>

            <option>
                Daily Work
            </option>

            <option>
                Part-time Work
            </option>

            <option>
                Temporary Work
            </option>

        </select>

    </div>


    <!-- EXTRA -->

    <div class="card">

        <h2>📝 Additional Details</h2>

        <label>
            Tell owners about your work
        </label>

        <textarea
            id="description"
            placeholder="Any additional information..."
        ></textarea>


        <div class="note">

            Your selected skills will be used to show you
            suitable work opportunities.

        </div>


        <button type="submit">

            Save Profile & View Owner Details →

        </button>

    </div>


</form>


<a
    class="back"
    href="role.html">

    ← Back to Role Selection

</a>

</div>


<script>

document
.getElementById("workerForm")
.addEventListener("submit", function(event) {

    event.preventDefault();


    /*
    GET SELECTED SKILLS
    */

    const skills =
        Array.from(
            document.querySelectorAll(
                '.skill input:checked'
            )
        )
        .map(function(input) {
            return input.value;
        });


    if (skills.length === 0) {

        alert(
            "Please select at least one skill."
        );

        return;

    }


    /*
    CREATE WORKER PROFILE
    */

    const workerProfile = {

        name:
            document
            .getElementById("name")
            .value
            .trim(),

        phone:
            document
            .getElementById("phone")
            .value
            .trim(),

        area:
            document
            .getElementById("area")
            .value
            .trim(),

        skills: skills,

        experience:
            document
            .getElementById("experience")
            .value
            .trim(),

        experienceDuration:
            document
            .getElementById("experienceDuration")
            .value
            .trim(),

        availability:
            document
            .getElementById("availability")
            .value,

        workPreference:
            document
            .getElementById("workPreference")
            .value,

        description:
            document
            .getElementById("description")
            .value
            .trim()

    };


    /*
    SAVE PROFILE
    */

    localStorage.setItem(
        "skillCircleWorkerProfile",
        JSON.stringify(workerProfile)
    );


    /*
    GO TO OWNER DETAILS / OWNER LIST
    */

    window.location.href =
        "ownerlist.html";

});

</script>

</body>

</html>
